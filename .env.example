# Vikunja instance URL (no trailing slash)
VIKUNJA_API_URL=https://vikunja.example.com

# API token from Vikunja → Settings → API Tokens
VIKUNJA_API_TOKEN=your_vikunja_api_token_here

# Password shown in the OAuth browser popup when connecting Claude.ai
MCP_AUTH_PASSWORD=choose-a-strong-password

# Random string of at least 32 characters for signing JWT access tokens
JWT_SECRET=replace-with-at-least-32-random-chars

# Public HTTPS URL where this MCP server is reachable (Claude.ai requires HTTPS)
BASE_URL=https://your-mcp-domain.example.com

# HTTP port (default: 3000)
# PORT=3000

# SQLite auth database path (default: ./data/auth.db)
# AUTH_DB_PATH=./data/auth.db
